# ==============================================================================
# AI RESEARCH HUB — ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# OPTION A: LOCAL DOCKER (Default)
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_research_hub?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/ai_research_hub?schema=public"

# ------------------------------------------------------------------------------
# OPTION B: SUPABASE CLOUD (Production / Staging)
# Replace [YOUR-PASSWORD] and [PROJECT-REF] with your Supabase credentials:
#
# 1. DATABASE_URL: Transaction Pooler (Port 6543) - used by Next.js app at runtime
# DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
#
# 2. DIRECT_URL: Direct Session Connection (Port 5432) - used by Prisma migrations
# DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"
# ------------------------------------------------------------------------------

# Next.js Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# NextAuth.js Configuration
# Generate secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET="your-random-32-char-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# Initial Seeded Account Credentials (Optional overrides for seeding)
ADMIN_INITIAL_PASSWORD="your-secure-admin-password"
USER_INITIAL_PASSWORD="your-secure-user-password"

# OpenAI Configuration (Server-Side Only - NEVER NEXT_PUBLIC_*)
OPENAI_API_KEY="your-openai-api-key-here"
OPENAI_SUMMARY_MODEL="gpt-4o-mini"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
OPENAI_EMBEDDING_DIMENSIONS="1536"

# Private Beta Registration Access Control (Server-Side Only - NEVER NEXT_PUBLIC_*)
# Set to "allowlist" to enforce invite-only registration; defaults to "open" for local dev.
BETA_REGISTRATION_MODE="allowlist"
# Comma-separated list of invited email addresses (normalized case-insensitively).
BETA_ALLOWED_EMAILS="researcher1@example.com,researcher2@example.com"

# CitedEvidence Scholar & CEDOA Research API (Server-Side Only - NEVER NEXT_PUBLIC_*)
CITEDEVIDENCE_API_KEY="your-citedevidence-api-key-here"
CITEDEVIDENCE_BASE_URL="https://scholar.citedevidence.com"

