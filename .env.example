# ==============================================================================
# AI RESEARCH HUB — ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# OPTION A: LOCAL DOCKER (Default)
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_research_hub?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/ai_research_hub?schema=public"

# ------------------------------------------------------------------------------
# OPTION B: SUPABASE CLOUD (Production / Staging)
# Replace [YOUR-PASSWORD] and [PROJECT-REF] with your Supabase credentials:
#
# 1. DATABASE_URL: Transaction Pooler (Port 6543) - used by Next.js app at runtime
# DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
#
# 2. DIRECT_URL: Direct Session Connection (Port 5432) - used by Prisma migrations
# DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"
# ------------------------------------------------------------------------------

# ------------------------------------------------------------------------------
# SUPABASE STORAGE CONFIGURATION (Server-Side Only - NEVER NEXT_PUBLIC_*)
# Replace with your project URL, anon key, and secret API key (sb_secret_... format):
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key-here"
SUPABASE_SECRET_KEY="sb_secret_your-secret-api-key-here"

# Next.js Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# NextAuth.js Configuration
# Generate secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET="your-random-32-char-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# Initial Seeded Account Credentials (Optional overrides for seeding)
ADMIN_INITIAL_PASSWORD="your-secure-admin-password"
USER_INITIAL_PASSWORD="your-secure-user-password"

# Multi-Model Router Configuration (Server-Side Only - NEVER NEXT_PUBLIC_*)
FAST_MODEL="gemini-3.5-flash-lite"
SMART_MODEL="claude-sonnet-5"
FAST_FALLBACK_MODEL="gpt-4o-mini"
SMART_FALLBACK_MODEL="gpt-4o"
EMBEDDING_MODEL="text-embedding-3-small"
ROUTER_MAX_TOKENS_AUTOCOMPLETE="256"
ROUTER_MAX_TOKENS_DRAFTING="4096"
ROUTER_MAX_TOKENS_REWRITING="2048"
ROUTER_MAX_TOKENS_SYNTHESIS="2200"
ROUTER_TIMEOUT_AUTOCOMPLETE_MS="12000"
ROUTER_TIMEOUT_DRAFTING_MS="60000"
ROUTER_TIMEOUT_REWRITING_MS="30000"
ROUTER_TIMEOUT_SYNTHESIS_MS="90000"

# Provider API Credentials (Server-Side Only - NEVER NEXT_PUBLIC_*)
OPENAI_API_KEY="your-openai-api-key-here"
ANTHROPIC_API_KEY="your-anthropic-api-key-here"
GEMINI_API_KEY="your-gemini-api-key-here"

# Private Beta Registration Access Control (Server-Side Only - NEVER NEXT_PUBLIC_*)
# Set to "allowlist" to enforce invite-only registration; defaults to "open" for local dev.
BETA_REGISTRATION_MODE="allowlist"
# Comma-separated list of invited email addresses (normalized case-insensitively).
BETA_ALLOWED_EMAILS="researcher1@example.com,researcher2@example.com"

# CitedEvidence Scholar & CEDOA Research API (Server-Side Only - NEVER NEXT_PUBLIC_*)
CITEDEVIDENCE_API_KEY="your-citedevidence-api-key-here"
CITEDEVIDENCE_BASE_URL="https://scholar.citedevidence.com"

# Scientific Table Extraction (Phase 3C Feature Flag) - Default: false (OFF)
# When false, table extraction is completely bypassed during PDF ingestion with zero side effects.
ENABLE_TABLE_EXTRACTION="false"

# ------------------------------------------------------------------------------
# DEDICATED LOCAL TEST DATABASE (Phase 3C Stage 2B Isolated Database Validation)
# Explicit safeguards: Test runners strictly require localhost/127.0.0.1.
# NEVER set these to point to remote Supabase instances.
# ------------------------------------------------------------------------------
LOCAL_TEST_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/ai_research_hub?schema=public"
LOCAL_TEST_DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:5432/ai_research_hub?schema=public"


