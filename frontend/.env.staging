# Firebase web config for the isolated STAGING project "paperaid-staging" (public identifiers, safe in the bundle).
# Build with `vite build --mode staging` (see deploy/deploy-staging-frontend.sh). Staging users are separate from
# production users; the staging API runs with its own database, bucket, queue and service account.
VITE_FIREBASE_API_KEY=AIzaSyALlHQQFrgKOBK9Z0NldpkcCrxfPXqi4Jc
VITE_FIREBASE_AUTH_DOMAIN=paperaid-staging.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=paperaid-staging
VITE_FIREBASE_APP_ID=1:839747437908:web:acd3b08ccf24d957b0b4c1

# Staging Cloud Run API
VITE_API_BASE_URL=https://paperaid-api-staging-307658066472.europe-west4.run.app
VITE_ENABLE_GOOGLE_SIGNIN=false
VITE_PRIVACY_CONTACT_EMAIL=silvercheptoris@gmail.com

# Environment-specific wording (e.g. where the staging database is hosted, in the Privacy Notice)
VITE_DEPLOYMENT=staging
