{
  "name": "ai-research-hub",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "node scripts/start-dev-isolated.cjs",
    "dev:unwrapped": "next dev",
    "postinstall": "prisma generate",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "test": "npx tsx tests/test-runner.ts",
    "test:integration": "npx tsx tests/test-runner.ts --integration",
    "test:proposal": "npx tsx tests/test-runner.ts --proposal",
    "db:generate": "prisma generate",
    "db:generate:table-proposal": "prisma generate --schema prisma/schema.table-proposal.prisma",
    "db:migrate": "node scripts/safe-migrate.cjs dev",
    "db:deploy": "node scripts/safe-migrate.cjs deploy",
    "db:status": "node scripts/safe-migrate.cjs status",
    "db:push": "node scripts/safe-migrate.cjs push",
    "db:studio": "node scripts/safe-migrate.cjs studio",
    "db:run": "node scripts/run-isolated-db.cjs",
    "db:validate": "prisma validate",
    "db:test:init": "npx tsx scripts/init-test-database.ts",
    "db:seed": "node scripts/run-isolated-db.cjs prisma/seed.js"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@google/genai": "^2.29.0",
    "@prisma/client": "^6.19.3",
    "@supabase/supabase-js": "^2.109.0",
    "@tiptap/extension-placeholder": "^3.31.4",
    "@tiptap/extension-table": "^3.31.4",
    "@tiptap/extension-table-cell": "^3.31.4",
    "@tiptap/extension-table-header": "^3.31.4",
    "@tiptap/extension-table-row": "^3.31.4",
    "@tiptap/extension-underline": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "@types/bcryptjs": "^2.4.6",
    "bcryptjs": "^3.0.3",
    "citeproc": "^2.4.63",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "docx": "^9.15.1",
    "lucide-react": "^0.475.0",
    "next": "14.2.35",
    "next-auth": "^4.24.15",
    "openai": "^6.49.0",
    "pdfkit": "^0.20.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^2.6.0",
    "unpdf": "^1.7.0",
    "ws": "^8.21.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^20.17.19",
    "@types/pdfkit": "^0.17.7",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/ws": "^8.18.1",
    "autoprefixer": "^10.4.20",
    "fflate": "^0.8.3",
    "postcss": "^8.5.2",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
  }
}
