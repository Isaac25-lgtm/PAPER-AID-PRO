datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// ENUMS
// ==========================================

enum UserRole {
  USER
  ADMIN
}

enum PaperProcessingStatus {
  METADATA_ONLY
  UPLOADED
  PROCESSING
  TEXT_EXTRACTED
  EMBEDDING
  COMPLETED
  FAILED
}

enum ProcessingStage {
  PDF_DOWNLOAD
  TEXT_EXTRACTION
  CHUNKING
  EMBEDDING_GENERATION
  SUMMARY_GENERATION
  CITATION_ANALYSIS
  METADATA_EXTRACTION
}

enum JobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum AIMessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum DocumentType {
  DRAFT
  MANUSCRIPT
  PROPOSAL
  LITERATURE_REVIEW
}

enum CitationType {
  BIBLIOGRAPHIC
  PASSAGE_VERIFIED
}

// ==========================================
// CORE ENTITIES
// ==========================================

model User {
  id            String          @id @default(cuid())
  email         String          @unique
  name          String?
  passwordHash  String?
  avatarUrl     String?
  role          UserRole        @default(USER)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  // Relationships
  conversations     AIConversation[]
  bookmarks         Bookmark[]
  collections       Collection[]
  researchDocuments ResearchDocument[]

  // Note: @@index([email]) omitted because @unique already provisions a PostgreSQL unique B-tree index
  @@map("users")
}

model Paper {
  id               String                @id @default(cuid())
  title            String
  abstract         String                @db.Text
  publicationDate  DateTime?
  journal          String?
  doi              String?               @unique
  arxivId          String?               @unique
  pmid             String?               @unique
  pmcid            String?               @unique
  semanticScholarId String?              @unique
  isOpenAccess     Boolean               @default(false)
  pdfUrl           String?
  storagePath      String?
  status           PaperProcessingStatus @default(UPLOADED)
  sourceProvenance Json?

  // --------------------------------------------------------------------------
  // SOURCE DOCUMENT METADATA (Verbatim Extracted Content from Manuscript)
  // These represent the author's original words extracted during the
  // TEXT_EXTRACTION processing pipeline stage (NOT AI-generated summaries).
  // --------------------------------------------------------------------------
  researchQuestion String?               @db.Text
  methodology      String?               @db.Text
  results          String?               @db.Text
  limitations      String?               @db.Text
  conclusion       String?               @db.Text

  keywords         String[]              @default([])
  citationCount    Int                   @default(0)
  rawMetadata      Json?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  // Relationships
  authors          PaperAuthor[]
  categories       PaperCategory[]
  chunks           PaperChunk[]
  aiSummary        AISummary?            // AI-generated interpretations stored separately
  processingJobs   ProcessingJob[]
  bookmarks        Bookmark[]
  conversations    AIConversation[]
  collections      CollectionPaper[]
  documentCitations DocumentCitation[]
  documentPapers   DocumentPaper[]

  @@index([status])
  @@index([publicationDate])
  @@index([title])
  @@map("papers")
}

model Author {
  id            String        @id @default(cuid())
  name          String
  institution   String?
  bio           String?       @db.Text
  orcid         String?       @unique

  // Note: paperCount is intentionally NOT stored here to avoid stale denormalized counters.
  // It is computed dynamically via _count: { papers: true } on PaperAuthor.

  // Cached Bibliometrics (Sourced from external academic registries: Semantic Scholar, Crossref, OpenAlex)
  citationCount Int           @default(0)
  hIndex        Int?

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Relationships
  papers        PaperAuthor[]

  @@index([name])
  @@map("authors")
}

model Category {
  id          String          @id @default(cuid())
  name        String          @unique
  slug        String          @unique
  description String?         @db.Text
  iconName    String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  // Relationships
  papers      PaperCategory[]

  // Note: @@index([slug]) omitted because @unique already provisions a PostgreSQL unique B-tree index
  @@map("categories")
}

model PaperAuthor {
  id              String   @id @default(cuid())
  paperId         String
  authorId        String
  orderIndex      Int      @default(0)
  isCorresponding Boolean  @default(false)
  createdAt       DateTime @default(now())

  // Foreign keys
  paper           Paper    @relation(fields: [paperId], references: [id], onDelete: Cascade)
  author          Author   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@unique([paperId, authorId])
  @@index([paperId])
  @@index([authorId])
  @@map("paper_authors")
}

model PaperCategory {
  id         String   @id @default(cuid())
  paperId    String
  categoryId String
  createdAt  DateTime @default(now())

  // Foreign keys
  paper      Paper    @relation(fields: [paperId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([paperId, categoryId])
  @@index([paperId])
  @@index([categoryId])
  @@map("paper_categories")
}

model PaperChunk {
  id         String   @id @default(cuid())
  paperId    String
  chunkIndex Int
  text       String   @db.Text
  section    String?
  pageNumber Int?
  tokenCount Int?
  metadata       Json?
  embedding           Unsupported("vector(1536)")?
  embeddingModel      String?
  embeddingDimensions Int?
  embeddingInputHash  String?
  embeddedAt          DateTime?
  createdAt           DateTime                     @default(now())

  // Foreign keys
  paper             Paper                        @relation(fields: [paperId], references: [id], onDelete: Cascade)
  documentCitations DocumentCitation[]

  @@unique([paperId, chunkIndex])
  @@index([paperId])
  @@map("paper_chunks")
}

model AISummary {
  id                 String   @id @default(cuid())
  paperId            String   @unique

  // --------------------------------------------------------------------------
  // AI-GENERATED SYNTHESIS & INTERPRETATIONS
  // Stored strictly separate from the original paper source text above.
  // --------------------------------------------------------------------------
  summary            String   @db.Text
  keyFindings        String[] @default([])
  methodologySummary String?  @db.Text
  limitations        String?  @db.Text
  conclusion         String?  @db.Text
  modelUsed          String
  promptVersion      String?
  citations          Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // Foreign keys
  paper              Paper    @relation(fields: [paperId], references: [id], onDelete: Cascade)

  @@map("ai_summaries")
}

model AIConversation {
  id        String      @id @default(cuid())
  userId    String
  paperId   String?
  title     String      @default("New Conversation")
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  // Foreign keys & relations
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  paper     Paper?      @relation(fields: [paperId], references: [id], onDelete: Cascade)
  messages  AIMessage[]

  @@index([userId])
  @@index([paperId])
  @@index([userId, paperId])
  @@map("ai_conversations")
}

model AIMessage {
  id             String         @id @default(cuid())
  conversationId String
  role           AIMessageRole
  content        String         @db.Text
  citations      Json?
  tokenCount     Int?
  createdAt      DateTime       @default(now())

  // Foreign keys
  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("ai_messages")
}

model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  paperId   String
  notes     String?  @db.Text
  createdAt DateTime @default(now())

  // Foreign keys
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  paper     Paper    @relation(fields: [paperId], references: [id], onDelete: Cascade)

  @@unique([userId, paperId])
  @@index([userId])
  @@index([paperId])
  @@map("bookmarks")
}

model ProcessingJob {
  id           String          @id @default(cuid())
  paperId      String
  stage        ProcessingStage
  status       JobStatus       @default(PENDING)
  attempt      Int             @default(1)
  maxAttempts  Int             @default(3)
  errorMessage String?         @db.Text
  errorStack   String?         @db.Text
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  // Foreign keys
  paper        Paper           @relation(fields: [paperId], references: [id], onDelete: Cascade)

  @@index([paperId])
  @@index([status])
  @@index([stage])
  @@map("processing_jobs")
}

model Collection {
  id          String            @id @default(cuid())
  userId      String
  name        String
  description String?           @db.Text
  color       String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  // Foreign keys & relations
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  papers      CollectionPaper[]

  @@unique([userId, name])
  @@index([userId])
  @@map("collections")
}

model CollectionPaper {
  id           String     @id @default(cuid())
  collectionId String
  paperId      String
  addedAt      DateTime   @default(now())

  // Foreign keys & relations
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  paper        Paper      @relation(fields: [paperId], references: [id], onDelete: Cascade)

  @@unique([collectionId, paperId])
  @@index([collectionId])
  @@index([paperId])
  @@map("collection_papers")
}

model ResearchDocument {
  id          String       @id @default(cuid())
  userId      String
  title       String       @default("Untitled Research Document")
  content     Json?
  textContent String?      @db.Text
  docType     DocumentType @default(DRAFT)
  version     Int          @default(1)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  // Relationships
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  citations    DocumentCitation[]
  linkedPapers DocumentPaper[]

  @@index([userId])
  @@index([updatedAt])
  @@map("research_documents")
}

model DocumentCitation {
  id           String       @id @default(cuid())
  documentId   String
  paperId      String
  chunkId      String?
  citationKey  String?
  citationText String
  citationType CitationType @default(BIBLIOGRAPHIC)
  pageNumber   Int?
  section      String?
  prefix       String?
  suffix       String?
  createdAt    DateTime     @default(now())

  // Foreign keys
  document     ResearchDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  paper        Paper            @relation(fields: [paperId], references: [id], onDelete: Cascade)
  chunk        PaperChunk?      @relation(fields: [chunkId], references: [id], onDelete: SetNull)

  @@index([documentId])
  @@index([paperId])
  @@index([chunkId])
  @@map("document_citations")
}

model DocumentPaper {
  id         String   @id @default(cuid())
  documentId String
  paperId    String
  addedAt    DateTime @default(now())

  // Foreign keys
  document   ResearchDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  paper      Paper            @relation(fields: [paperId], references: [id], onDelete: Cascade)

  @@unique([documentId, paperId])
  @@index([documentId])
  @@index([paperId])
  @@map("document_papers")
}

