datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "./generated-client"
}

// ==========================================
// ENUMS
// ==========================================

enum UserRole {
  USER
  ADMIN
}

enum PaperProcessingStatus {
  METADATA_ONLY
  UPLOADED
  PROCESSING
  TEXT_EXTRACTED
  EMBEDDING
  COMPLETED
  FAILED
}

enum ProcessingStage {
  PDF_DOWNLOAD
  TEXT_EXTRACTION
  CHUNKING
  EMBEDDING_GENERATION
  SUMMARY_GENERATION
  CITATION_ANALYSIS
  METADATA_EXTRACTION
  TABLE_EXTRACTION
}

enum JobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum AIMessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum TableExtractionStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  SUPERSEDED
}

enum TableVerificationStatus {
  UNVERIFIED              // Default: Raw candidate awaiting verification. Never promoted implicitly.
  VERIFIED                // Deterministic token intersection + verbatim string match + header alignment
  UNVERIFIED_VISUAL_ONLY  // Extracted from visual raster where native vector text tokens are absent
  AMBIGUOUS               // Competing spatial candidates or unresolved coordinate splits
  DISAGREEMENT            // Spatial token stream conflicts with visual OCR candidate
  REJECTED                // Failed validation (transcription drift, boundary misalignment, misattribution)
}

enum TableExtractionMethod {
  SPATIAL_2D
  VISION_MULTIMODAL
  HYBRID_RECONCILED
}

enum TableMetricUnit {
  PERCENT
  RATIO
  COUNT
  HERTZ
  MILLISECONDS
  DECIBELS
  UNSPECIFIED
}

// ==========================================
// CORE ENTITIES
// ==========================================

model User {
  id            String          @id @default(cuid())
  email         String          @unique
  name          String?
  passwordHash  String?
  avatarUrl     String?
  role          UserRole        @default(USER)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  // Relationships
  conversations AIConversation[]
  bookmarks     Bookmark[]

  @@map("users")
}

model Paper {
  id               String                @id @default(cuid())
  title            String
  abstract         String                @db.Text
  publicationDate  DateTime?
  journal          String?
  doi              String?               @unique
  arxivId          String?               @unique
  pmid             String?               @unique
  pmcid            String?               @unique
  semanticScholarId String?              @unique
  isOpenAccess     Boolean               @default(false)
  pdfUrl           String?
  storagePath      String?
  status           PaperProcessingStatus @default(UPLOADED)
  sourceProvenance Json?

  // --------------------------------------------------------------------------
  // SOURCE DOCUMENT METADATA (Verbatim Extracted Content from Manuscript)
  // --------------------------------------------------------------------------
  researchQuestion String?               @db.Text
  methodology      String?               @db.Text
  results          String?               @db.Text
  limitations      String?               @db.Text
  conclusion       String?               @db.Text

  keywords         String[]              @default([])
  citationCount    Int                   @default(0)
  rawMetadata      Json?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  // Relationships
  authors             PaperAuthor[]
  categories          PaperCategory[]
  chunks              PaperChunk[]
  aiSummary           AISummary?
  processingJobs      ProcessingJob[]
  bookmarks           Bookmark[]
  conversations       AIConversation[]
  tableExtractionRuns TableExtractionRun[]
  paperTables         PaperTable[]
  tableCells          TableCell[]

  @@index([status])
  @@index([publicationDate])
  @@index([title])
  @@map("papers")
}

model Author {
  id            String        @id @default(cuid())
  name          String
  institution   String?
  bio           String?       @db.Text
  orcid         String?       @unique
  citationCount Int           @default(0)
  hIndex        Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Relationships
  papers        PaperAuthor[]

  @@index([name])
  @@index([citationCount(sort: Desc)])
  @@index([hIndex(sort: Desc)])
  @@map("authors")
}

model PaperAuthor {
  id        String   @id @default(cuid())
  paperId   String
  authorId  String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  // Foreign keys
  paper     Paper    @relation(fields: [paperId], references: [id], onDelete: Cascade)
  author    Author   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@unique([paperId, authorId])
  @@index([paperId])
  @@index([authorId])
  @@map("paper_authors")
}

model Category {
  id          String          @id @default(cuid())
  name        String          @unique
  slug        String          @unique
  description String?         @db.Text
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  // Relationships
  papers      PaperCategory[]

  @@map("categories")
}

model PaperCategory {
  id         String   @id @default(cuid())
  paperId    String
  categoryId String
  createdAt  DateTime @default(now())

  // Foreign keys
  paper      Paper    @relation(fields: [paperId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([paperId, categoryId])
  @@index([paperId])
  @@index([categoryId])
  @@map("paper_categories")
}

model PaperChunk {
  id         String   @id @default(cuid())
  paperId    String
  chunkIndex Int
  text       String   @db.Text
  section    String?
  pageNumber Int?
  tokenCount Int?
  metadata   Json?
  embedding           Unsupported("vector(1536)")?
  embeddingModel      String?
  embeddingDimensions Int?
  embeddingInputHash  String?
  embeddedAt          DateTime?
  createdAt           DateTime                     @default(now())

  // Foreign keys
  paper      Paper    @relation(fields: [paperId], references: [id], onDelete: Cascade)

  @@unique([paperId, chunkIndex])
  @@index([paperId])
  @@map("paper_chunks")
}

model AISummary {
  id                 String   @id @default(cuid())
  paperId            String   @unique
  summary            String   @db.Text
  keyFindings        String[] @default([])
  methodologySummary String?  @db.Text
  limitations        String?  @db.Text
  conclusion         String?  @db.Text
  modelUsed          String
  promptVersion      String?
  citations          Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // Foreign keys
  paper              Paper    @relation(fields: [paperId], references: [id], onDelete: Cascade)

  @@map("ai_summaries")
}

model AIConversation {
  id        String      @id @default(cuid())
  userId    String
  paperId   String?
  title     String      @default("New Conversation")
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  // Foreign keys & relations
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  paper     Paper?      @relation(fields: [paperId], references: [id], onDelete: Cascade)
  messages  AIMessage[]

  @@index([userId])
  @@index([paperId])
  @@index([userId, paperId])
  @@map("ai_conversations")
}

model AIMessage {
  id             String         @id @default(cuid())
  conversationId String
  role           AIMessageRole
  content        String         @db.Text
  citations      Json?
  tokenCount     Int?
  createdAt      DateTime       @default(now())

  // Foreign keys
  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("ai_messages")
}

model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  paperId   String
  notes     String?  @db.Text
  createdAt DateTime @default(now())

  // Foreign keys
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  paper     Paper    @relation(fields: [paperId], references: [id], onDelete: Cascade)

  @@unique([userId, paperId])
  @@index([userId])
  @@index([paperId])
  @@map("bookmarks")
}

model ProcessingJob {
  id           String          @id @default(cuid())
  paperId      String
  stage        ProcessingStage
  status       JobStatus       @default(PENDING)
  attempt      Int             @default(1)
  maxAttempts  Int             @default(3)
  errorMessage String?         @db.Text
  errorStack   String?         @db.Text
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  // Foreign keys & relations
  paper               Paper                @relation(fields: [paperId], references: [id], onDelete: Cascade)
  tableExtractionRuns TableExtractionRun[]

  @@index([paperId])
  @@index([status])
  @@index([stage])
  @@map("processing_jobs")
}

// ==========================================
// PROPOSED TABLE EVIDENCE MODELS (PHASE 3C)
// ==========================================

model TableExtractionRun {
  id                String                @id @default(cuid())
  paperId           String
  processingJobId   String?
  sourcePdfHash     String                // SHA-256 of the exact PDF manuscript analyzed
  engineVersion     String                // e.g. "hybrid-v1.0"
  extractionMethod  TableExtractionMethod @default(HYBRID_RECONCILED)
  status            TableExtractionStatus @default(PENDING)
  isActive          Boolean               @default(false) // Only active run exposed to synthesis / RAG
  tableCount        Int                   @default(0)
  cellCount         Int                   @default(0)
  verifiedCellCount Int                   @default(0)
  config            Json?
  startedAt         DateTime              @default(now())
  completedAt       DateTime?
  errorMessage      String?               @db.Text
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  // Relationships
  paper             Paper                 @relation(fields: [paperId], references: [id], onDelete: Cascade)
  processingJob     ProcessingJob?        @relation(fields: [processingJobId], references: [id], onDelete: SetNull)
  tables            PaperTable[]

  // Supporting composite unique constraint for cross-field foreign key validation:
  @@unique([id, paperId, sourcePdfHash])
  @@index([paperId])
  @@index([sourcePdfHash])
  @@index([paperId, isActive])
  @@index([status])
  @@map("table_extraction_runs")
}

model PaperTable {
  id                    String                @id @default(cuid())
  extractionRunId       String
  paperId               String
  tableIndex            Int                   // 0-based sequence in manuscript detection order
  pageNumber            Int
  tableNumber           String                // e.g. "Table 1", "Table A.1", "Table 2 (cont.)"
  caption               String?               @db.Text
  multiPagePart         Int                   @default(1) // 1 for first part, 2 for continuation, etc.
  parentTableId         String?               // Self-reference to first part of multi-page table
  tableBbox             Json                  // { x0, y0, x1, y1 }
  sourcePdfHash         String                // SHA-256 of original PDF
  headerHierarchy       Json                  // { superHeaders: [], columnHeaders: [], rowHeaders: [], subrowHeaders: [] }
  datasetNames          String[]              @default([])
  rawMarkdown           String?               @db.Text
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  // Composite foreign key to TableExtractionRun: strictly enforces consistent paperId AND sourcePdfHash!
  extractionRun         TableExtractionRun    @relation(fields: [extractionRunId, paperId, sourcePdfHash], references: [id, paperId, sourcePdfHash], onDelete: Cascade)
  paper                 Paper                 @relation(fields: [paperId], references: [id], onDelete: Cascade)

  parentTable           PaperTable?           @relation("MultiPageTableContinuation", fields: [parentTableId, extractionRunId, paperId], references: [id, extractionRunId, paperId], onDelete: Cascade)
  continuationTables    PaperTable[]          @relation("MultiPageTableContinuation")
  cells                 TableCell[]

  // Natural composite uniqueness within an extraction run:
  @@unique([extractionRunId, tableIndex])
  // Supporting composite unique constraint for cell foreign key validation:
  @@unique([id, extractionRunId, paperId])
  @@index([paperId])
  @@index([extractionRunId])
  @@index([sourcePdfHash])
  @@index([paperId, tableNumber])
  @@map("paper_tables")
}

model TableCell {
  id                     String                  @id @default(cuid())
  tableId                String
  extractionRunId        String
  paperId                String
  rowIdx                 Int
  colIdx                 Int
  rowSpan                Int                     @default(1)
  colSpan                Int                     @default(1)

  // Verbatim Raw Manuscript Evidence (Strictly preserved)
  rawPrintedValue        String                  // Exact string as detected (e.g. "88.35", "−0.05", "0.896(0.845–0.947)")
  verbatimPdfTokens      String[]                @default([]) // Physical PDF TextItem tokens inside bounding box
  isMissingOrNa          Boolean                 @default(false)
  footnoteReferences     String[]                @default([])

  // Normalized Scientific Data
  normalizedNumericValue Float?
  confidenceInterval     Float[]                 @default([])
  standardDeviation      Float?
  unit                   TableMetricUnit         @default(UNSPECIFIED)
  scale                  String?

  // Semantic Attribution
  modelOrMethod          String                  // e.g. "PointPillars", "Simple Voting"
  groupOrSubrow          String?                 // e.g. "Car Mod.", "Validation Set"
  datasetOrCohort        String?                 // e.g. "KITTI BEV", "Cairo Ultrasound"
  experimentalCondition  String?                 // e.g. "3D BEV", "Entropy + Phase"
  headerPath             String[]                @default([]) // Hierarchical path: ["Car", "Mod."]

  // Geometry Provenance
  cellBbox               Json?                   // { x0, y0, x1, y1 }
  rowInterval            Float[]                 @default([]) // [yMin, yMax]
  colInterval            Float[]                 @default([]) // [xMin, xMax]
  cropImageUri           String?

  // Verification Status: STRICT SAFETY DEFAULT
  verificationStatus     TableVerificationStatus @default(UNVERIFIED)
  verificationMethod     String                  @default("UNVERIFIED")
  verifiedAt             DateTime?
  verifierVersion        String?
  verificationNotes      String?                 @db.Text
  transcriptionError     Boolean                 @default(false)
  columnShiftError       Boolean                 @default(false)
  rowMisattribution      Boolean                 @default(false)
  coordinateMismatch     Boolean                 @default(false)

  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  // Composite foreign key to PaperTable: strictly enforces matching extractionRunId AND paperId!
  table                  PaperTable              @relation(fields: [tableId, extractionRunId, paperId], references: [id, extractionRunId, paperId], onDelete: Cascade)
  paper                  Paper                   @relation(fields: [paperId], references: [id], onDelete: Cascade)
  auditLogs              TableCellAuditLog[]

  // Natural cell position uniqueness within a table instance:
  @@unique([tableId, rowIdx, colIdx])
  @@index([tableId])
  @@index([extractionRunId])
  @@index([paperId, verificationStatus])
  @@index([verificationStatus])
  @@index([modelOrMethod, verificationStatus])
  @@index([datasetOrCohort, verificationStatus])
  @@map("table_cells")
}

model TableCellAuditLog {
  id              String                  @id @default(cuid())
  cellId          String
  previousStatus  TableVerificationStatus
  newStatus       TableVerificationStatus
  decisionReason  String                  @db.Text
  verifierVersion String
  sourcePdfHash   String
  checkedTokens   String[]                @default([])
  errorFlags      Json?
  actor           String                  @default("SYSTEM_CELL_VERIFIER")
  timestamp       DateTime                @default(now())

  // Relationships
  cell            TableCell               @relation(fields: [cellId], references: [id], onDelete: Cascade)

  @@index([cellId])
  @@index([timestamp])
  @@index([newStatus])
  @@map("table_cell_audit_logs")
}
