# Copy to .env for local development. Production values are set on Cloud Run (see ../docs/DEPLOYMENT.md).
ENV=development
DATABASE_URL=postgresql+psycopg://postgres:@127.0.0.1:5432/paperaid
FIREBASE_PROJECT_ID=paperaid
REQUIRE_EMAIL_VERIFIED=true
ADMIN_EMAILS=
# Invite-only: comma-separated emails allowed to sign in (admins always allowed). Empty = open sign-up.
ALLOWED_EMAILS=
STORAGE_BACKEND=local
TASKS_BACKEND=inline
# A real, monitored address unlocks Crossref/OpenAlex polite pools and Unpaywall OA lookups.
CONTACT_EMAIL=
NCBI_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
# AI (optional until keys are provided): AI_PROVIDER=anthropic|openai|gemini|none
AI_PROVIDER=none
AI_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
EMBEDDING_PROVIDER=none
EMBEDDING_MODEL=

# Verify each AI claim against its cited passages with a second model call (recommended).
AI_VERIFY_CLAIMS=true
# Background housekeeping shortly after start (storage cleanup, rate-limit purge, stuck-job recovery).
MAINTENANCE_ON_STARTUP=true
# Trust the last X-Forwarded-For hop for per-caller rate limits (empty = automatic: on in production).
# TRUST_FORWARDED_FOR=
